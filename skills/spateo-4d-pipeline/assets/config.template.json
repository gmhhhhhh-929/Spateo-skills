{
  "schema_version": "spateo-4d/v4",
  "inputs": {
    "stage1": "/data/source.h5ad",
    "stage2": "/data/target.h5ad",
    "coordinate_unit": "declare shared unit"
  },
  "workflow": {
    "entry": "alignment",
    "until": "features",
    "frame_id": null,
    "species": null
  },
  "labels": {
    "stage1": "source",
    "stage2": "target"
  },
  "alignment": {
    "spatial_key": "spatial_3d",
    "counts_layer": "counts",
    "x_is_counts": false,
    "log_layer": "log1p",
    "aligned_key": "aligned",
    "target_sum": 10000.0,
    "mode": "SN-S",
    "n_sampling": 2000,
    "sampling_method": "random",
    "max_iter": 200,
    "nonrigid_start_iter": 80,
    "nn_init": true,
    "use_annotation": false
  },
  "subset": {
    "annotation_key": "anno",
    "group": "choose observed annotation"
  },
  "mapping": {
    "key": "cells_mapping",
    "alpha": 0.001,
    "numItermax": 200,
    "numItermaxEmd": 100000,
    "target_sum": 10000.0,
    "max_pairs": 25000000
  },
  "morphofield": {
    "key": "VecFld_morpho",
    "M": 100,
    "lambda_": 0.02,
    "restart_num": 1,
    "restart_seed": [
      0
    ],
    "max_iter": 8,
    "beta": null,
    "tol": 1e-05
  },
  "trajectory": {
    "enabled": true,
    "key": "fate_morpho",
    "t_end": 1.0,
    "interpolation_num": 50,
    "direction": "forward"
  },
  "metrics": {
    "enabled": true,
    "selected": [
      "speed",
      "acceleration",
      "curl",
      "divergence",
      "torsion",
      "curvature",
      "jacobian_frobenius"
    ],
    "glm_metrics": [],
    "glm_genes": [],
    "glm_min_cells": 10,
    "glm_top_plots": 6,
    "qval_threshold": 0.05,
    "llf_threshold": null
  },
  "gp": {
    "enabled": false,
    "genes": [],
    "training_iter": 50,
    "method": "SVGP",
    "inducing_num": 512
  },
  "dashboard": {
    "enabled": true,
    "max_points": 0,
    "max_target_points": 0,
    "max_vectors": 600,
    "max_trajectories": 200,
    "write_html": true,
    "default_feature": "displacement",
    "cdn": false
  },
  "runtime": {
    "device": "cpu",
    "seed": 0
  }
}
