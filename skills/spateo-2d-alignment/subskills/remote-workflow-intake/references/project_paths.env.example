# Copy to config/project_paths.env and edit for the target cluster/dataset.

WORKDIR=/path/to/spateo_interactive
DATASET_ROOT=/path/to/input_h5ad_directory
SOURCE_STAGE1_CSV=/path/to/source_stage1_or_alignment_points.csv
RECIPE_JSON=/path/to/correction_recipe.json

POSTHOC_DIR=${WORKDIR}/results/full_stage1_posthoc_corrected
RIGID_OUTDIR=${WORKDIR}/results/rigid_sns_from_posthoc_corrected

# Remote workflows should not generate HTML by default. Generate viewers locally
# from a local full-coordinate cache. Set GENERATE_HTML=1 only for explicit
# local/interactive runs.
GENERATE_HTML=0
HTML_OUTDIR=${RIGID_OUTDIR}/visualization_3d

# Optional SN-N polish runs must provide an explicit full-coordinate
# initialization CSV. Leave unset unless running run_mild_snn_polish.sh.
# MILD_SNN_INITIAL_CSV=/path/to/explicit_corrected_points.csv
# MILD_SNN_PAIR_START_ORDER=1
# MILD_SNN_N_SLICES=10
# MILD_SNN_ENRICH_CELLTYPES=

# Optional multicelltype refinement runs must provide an explicit biological
# target and slice window. Leave unset unless running
# scripts/run_refine_multicelltype_trial.sh.
# REFINE_TARGET_CELLTYPE=Heart
# REFINE_TARGET_SLICES=10-20

CONDA_ENV=/path/to/conda/env
PROJECT_ACCOUNT=root.project.YOUR_PROJECT
WALLTIME=24:00:00
DSUB_RESOURCE=cpu=16;gpu=1;mem=120000

# Slice window. N_SLICES=0 means all discovered slices from PAIR_START_ORDER.
PAIR_START_ORDER=1
N_SLICES=0

# Rigid-only defaults.
STAGE1_MODE=SN-S
STAGE2_MODE=none
STAGE1_MAX_ITER=300
MAX_CELLS_PER_SLICE=0
N_SAMPLING_REF=40000
REQUIRE_CUDA=1
